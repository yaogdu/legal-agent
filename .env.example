LEGAL_AGENT_ENV=dev
LEGAL_AGENT_API_HOST=0.0.0.0
LEGAL_AGENT_API_PORT=8080

DATABASE_DSN=postgresql://legal_agent:legal_agent@postgres:5432/legal_agent

AGENTLEDGER_POSTGRES_DSN=postgresql://legal_agent:legal_agent@postgres:5432/legal_agent
AGENTLEDGER_POSTGRES_SCHEMA=agentledger
AGENTLEDGER_BLOB_DIR=/data/agentledger/blobs

LEGAL_AGENT_DATA_DIR=/data/legal-agent
RAG_SOURCE_MANIFEST=rag/labor_dispute_sources.yaml
RAG_SEED_FILE=rag/seeds/labor_dispute_minimal.json

TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=legal-agent-worker-dev
TEMPORAL_RAG_TASK_QUEUE=legal-agent-rag-worker-dev
TEMPORAL_EMBEDDING_TASK_QUEUE=legal-agent-embedding-worker-dev
TEMPORAL_START_WORKFLOWS=true
TEMPORAL_SEARCH_ATTRIBUTES_ENABLED=true

LEGAL_AGENT_USER_INPUT_TIMEOUT_SECONDS=86400
LEGAL_AGENT_APPROVAL_TIMEOUT_SECONDS=86400

LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://langfuse-web:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_PROJECT=legal-agent
OTEL_EXPORTER_OTLP_ENDPOINT=http://langfuse-web:3000/api/public/otel

LEGAL_AGENT_LLM_ENABLED=false
LEGAL_AGENT_LLM_PROVIDER=openai_compatible
LEGAL_AGENT_LLM_BASE_URL=
LEGAL_AGENT_LLM_API_KEY=
LEGAL_AGENT_LLM_MODEL=
LEGAL_AGENT_LLM_TIMEOUT_SECONDS=60
LEGAL_AGENT_LLM_TEMPERATURE=0.2
